# ask-human-mcp environment configuration.
# Copy to /etc/ask-human-mcp/env on the server (mode 0640, owned by askhuman:askhuman).

# Slack bot token (xoxb-...). Required.
# Generate by installing the Slack app from the manifest in README.md, then copy
# Bot User OAuth Token from "OAuth & Permissions".
SLACK_BOT_TOKEN=xoxb-REPLACE_ME

# Default Slack channel or DM ID where questions are posted.
# For a DM with yourself, this is the channel ID returned by conversations.open.
# Find IDs by right-clicking a conversation in Slack -> "View channel details".
SLACK_CHANNEL_ID=DXXXXXXXXXX

# Slack user ID of the human responder. Replies from any other user are ignored.
# Find via your Slack profile -> "Copy member ID".
# IMPORTANT: this must be the account you actually reply with in Slack, not
# whichever account a tool happens to return. If you have multiple accounts in
# the same workspace, the wrong ID here causes every reply to be silently
# dropped by the filter in slack.py. The server logs `startup.identity_resolved`
# at boot with the resolved name + email so you can verify.
SLACK_USER_ID=UXXXXXXXXXX

# HTTP bind address. Behind a reverse proxy, keep host=127.0.0.1.
HOST=127.0.0.1
PORT=8765

# Polling cadence for conversations.replies. 3s is a good default.
POLL_INTERVAL_SECONDS=3.0

# Hard cap on per-call timeout (seconds). Tool input cannot exceed this.
MAX_TIMEOUT_SECONDS=14400

# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
